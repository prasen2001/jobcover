# Copy this file to .env in the project root. This is the only env file used.
# AI provider: gemini | groq | ollama
AI_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_CONTEXT_LENGTH=8192
# LaTeX resumes need a larger input/output window than cover letters.
OLLAMA_LATEX_CONTEXT_LENGTH=16384
OLLAMA_LATEX_MAX_TOKENS=4096
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-too
DATABASE_URL=sqlite:///jobcover.db
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5001
FLASK_DEBUG=true

# Backend logs are written to the terminal and this rotating file.
LOG_LEVEL=INFO
LOG_FILE=backend/logs/jobcover.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3

# Resume parsing: standard | ocr | vlm
DOCLING_PIPELINE=standard
DOCLING_OCR_LANGUAGES=en
DOCLING_OCR_ENGINE=tesseract
MAX_UPLOAD_MB=10

# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:5173

