# Copy this file to .env in the project root. This is the only env file used.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-too
DATABASE_URL=sqlite:///jobcover.db
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5001
FLASK_DEBUG=true

# Resume parsing: standard | ocr | vlm
DOCLING_PIPELINE=standard
DOCLING_OCR_LANGUAGES=en
DOCLING_OCR_ENGINE=tesseract
MAX_UPLOAD_MB=10

# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:5173

